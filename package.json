{
  "name": "designer-interview-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "build:single": "SINGLE_FILE=1 VITE_HASH_ROUTER=1 tsc -b && SINGLE_FILE=1 VITE_HASH_ROUTER=1 vite build",
    "build:pages": "tsc -b && BASE_PATH=./ VITE_HASH_ROUTER=1 vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
