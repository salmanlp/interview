# Shared-database mode (optional).
#
# Leave these unset and the app runs entirely locally: IndexedDB, no account,
# no network. Set both and it runs against your team's Supabase project, and
# requires a sign-in.
#
# Both values are safe to expose in the browser bundle — the anon key grants no
# access on its own, because every table has row-level security requiring an
# authenticated session. Never put the service_role key here.
#
# In Netlify: Site configuration → Environment variables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
